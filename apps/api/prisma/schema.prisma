generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Phase 0: 13 core tables ---

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  // Null for the pre-auth stub row; a user can log in only with a hash set.
  passwordHash String?   @map("password_hash")
  role         String    @default("member") // "owner" | "member"
  createdAt    DateTime  @default(now()) @map("created_at")
  projects     Project[]
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  // sha256 of the random cookie token -- the raw token is never stored.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Project {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows Workflow[]
  templates Template[]
  settings  Setting[]

  @@map("projects")
}

model Agent {
  id           String   @id
  version      String
  name         String
  description  String
  manifest     Json
  status       String   @default("active")
  discoveredAt DateTime @default(now()) @map("discovered_at")

  workflows Workflow[]
  prompts   Prompt[]
  settings  Setting[]

  @@map("agents")
}

model Workflow {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  agentId      String   @map("agent_id")
  agentVersion String   @map("agent_version")
  status       String   @default("running")
  inputParams  Json     @map("input_params")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent            Agent             @relation(fields: [agentId], references: [id])
  steps            WorkflowStep[]
  events           Event[]
  templateRunSteps TemplateRunStep[]

  @@map("workflows")
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  stepKey    String   @map("step_key")
  sequence   Int
  humanGate  Boolean  @map("human_gate")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workflow  Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  job       Job?
  artifacts Artifact[]

  @@map("workflow_steps")
}

model Job {
  id               String   @id @default(uuid())
  workflowStepId   String   @unique @map("workflow_step_id")
  queueJobId       String?  @map("queue_job_id")
  params           Json
  status           String   @default("pending")
  // Which provider config actually served this job (null for jobs that
  // predate attribution or steps without a capability) -- powers /stats/costs.
  providerConfigId String?  @map("provider_config_id")
  providerType     String?  @map("provider_type")
  createdAt        DateTime @default(now()) @map("created_at")

  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  runs         JobRun[]
  events       Event[]

  @@index([providerType])
  @@map("jobs")
}

model JobRun {
  id              String    @id @default(uuid())
  jobId           String    @map("job_id")
  attemptNumber   Int       @map("attempt_number")
  status          String
  progressPercent Int?      @map("progress_percent")
  progressMessage String?   @map("progress_message")
  error           Json?
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  job  Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  logs Log[]

  @@map("job_runs")
}

model Artifact {
  id              String   @id @default(uuid())
  workflowStepId  String   @map("workflow_step_id")
  kind            String
  mimeType        String   @map("mime_type")
  storageBackend  String   @default("local_fs") @map("storage_backend")
  storageKey      String   @map("storage_key")
  sizeBytes       BigInt?  @map("size_bytes")
  checksum        String?
  isPrimaryOutput Boolean  @default(true) @map("is_primary_output")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  workflowStep WorkflowStep      @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  versions     ArtifactVersion[]

  @@map("artifacts")
}

model ArtifactVersion {
  id            String   @id @default(uuid())
  artifactId    String   @map("artifact_id")
  versionNumber Int      @map("version_number")
  storageKey    String   @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@map("artifact_versions")
}

model Prompt {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  key       String
  version   Int
  template  String
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, key, version])
  @@map("prompts")
}

model Log {
  id        String   @id @default(uuid())
  jobRunId  String   @map("job_run_id")
  level     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  jobRun JobRun @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@map("logs")
}

model Event {
  id         String   @id @default(uuid())
  workflowId String?  @map("workflow_id")
  jobId      String?  @map("job_id")
  type       String
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("events")
}

model Setting {
  id        String @id @default(uuid())
  scope     String
  projectId String? @map("project_id")
  agentId   String? @map("agent_id")
  key       String
  value     Json

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   Agent?   @relation(fields: [agentId], references: [id])

  @@unique([scope, projectId, agentId, key])
  @@map("settings")
}

// --- Extension: 6 new tables (BYOK providers + workflow templates) ---

model Capability {
  id          String @id @default(uuid())
  key         String @unique
  label       String
  description String

  providerConfigs ProviderConfig[]

  @@map("capabilities")
}

model ProviderConfig {
  id              String   @id @default(uuid())
  capabilityId    String   @map("capability_id")
  providerType    String   @map("provider_type")
  name            String
  baseUrl         String?  @map("base_url")
  authMode        String   @map("auth_mode")
  encryptedSecret String?  @map("encrypted_secret")
  config          Json     @default("{}")
  isDefault       Boolean  @default(false) @map("is_default")
  scope           String   @default("global")
  projectId       String?  @map("project_id")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  capability Capability @relation(fields: [capabilityId], references: [id])

  @@map("provider_configs")
}

model Template {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   TemplateStep[]
  runs    TemplateRun[]

  @@map("templates")
}

model TemplateStep {
  id                            String   @id @default(uuid())
  templateId                    String   @map("template_id")
  stepOrder                     Int      @map("step_order")
  agentId                       String   @map("agent_id")
  agentVersion                  String   @map("agent_version")
  agentStepKey                  String   @map("agent_step_key")
  producesArtifactKindsSnapshot Json     @map("produces_artifact_kinds_snapshot")
  inputSchemaSnapshot           Json     @map("input_schema_snapshot")
  inputMapping                  Json     @map("input_mapping")
  createdAt                     DateTime @default(now()) @map("created_at")

  template Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  runSteps TemplateRunStep[]

  @@map("template_steps")
}

model TemplateRun {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  status     String   @default("pending")
  runInputs  Json     @map("run_inputs")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  steps    TemplateRunStep[]

  @@map("template_runs")
}

model TemplateRunStep {
  id             String   @id @default(uuid())
  templateRunId  String   @map("template_run_id")
  templateStepId String   @map("template_step_id")
  workflowId     String?  @map("workflow_id")
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  templateRun  TemplateRun  @relation(fields: [templateRunId], references: [id], onDelete: Cascade)
  templateStep TemplateStep @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
  workflow     Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@map("template_run_steps")
}

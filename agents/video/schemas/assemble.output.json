{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "const": "video" },
          "mimeType": { "type": "string" },
          "metadata": {
            "type": "object",
            "properties": {
              "durationSec": { "type": "number" },
              "captioned": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}

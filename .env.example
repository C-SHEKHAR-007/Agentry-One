# ---- Docker Compose (docker compose up) -------------------------------------
# PostgreSQL and Redis are not in compose; they run natively on the host and
# compose uses DATABASE_URL / REDIS_URL below. With plain `docker compose up`
# (private network) use host.docker.internal instead of localhost in them;
# scripts/local-up.sh (host networking) uses them as-is.
WEB_PORT=8080
# local (shared volume) or azure (set AZURE_STORAGE_CONNECTION_STRING and a
# dedicated container)
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=agentry-artifacts
# true = bake CPU PyTorch + diffusers into the worker for on-box SD-Turbo (~2 GB)
INSTALL_LOCAL_SD=false
# Development only: placeholder images when no image model is available
SKETCH_ALLOW_PLACEHOLDER=false
# Which proxies to trust for X-Forwarded-For (default: loopback + private nets)
TRUST_PROXY=
# Leave unset; "false" only to test a production build over plain HTTP
COOKIE_SECURE=

# ---- Local development (API/worker run directly on the host) -----------------
DATABASE_URL=postgresql://agentry:agentry_dev@localhost:5432/agentry
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32 -- never commit the real value
AGENTRY_CREDENTIALS_KEY=

# The mandatory static API key clients must send in the X-API-Key header
AGENTRY_API_KEY=

# Where workers reach the API (used to fetch artifacts by id)
AGENTRY_API_URL=http://localhost:4000

# Simulated Google login / social "connect" flows for local development.
# Only honoured when set to "true" AND NODE_ENV is not "production".
AGENTRY_DEV_MOCKS=false

# Comma-separated browser origins allowed to make credentialed cross-origin
# API calls. Leave empty when the web UI reaches the API via its /api proxy.
CORS_ORIGINS=

# Public URL of the web UI (OAuth callbacks redirect here)
FRONTEND_URL=http://localhost:5173

# Hosts a provider baseUrl may use even though they resolve to a private
# address (localhost and OLLAMA_HOST's host are always allowed).
PROVIDER_PRIVATE_HOSTS=

# Browser-facing path of this API, used to build local artifact download URLs.
PUBLIC_API_BASE=/api

# govt-job-agent: where to send extracted job notifications as draft posts.
# The key must equal INGEST_API_KEY in Sarkari Duniya's .env. From the bundled
# docker stack use an address the worker container can reach (not localhost);
# with docker-compose.local.yml (host networking) http://localhost:3000 works.
SARKARI_DUNIYA_API_URL=
SARKARI_DUNIYA_INGEST_KEY=
# Base URL for review links in the agent's report (defaults to the API URL)
SARKARI_DUNIYA_PUBLIC_URL=

# Optional tuning
# LOG_LEVEL=info
# REAPER_INTERVAL_MS=120000

# Google OAuth 2.0 Credentials (optional; uses developer mock fallback if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Social publishing app credentials (optional per platform; each falls back
# to a local mock connect flow when unset -- see docs/17-social-publishing.md).
# Register a dev app and set redirect URI to http://localhost:4000/social-accounts/oauth/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Instagram (via Facebook Login for Business + the Graph API -- only Business
# /Creator accounts linked to a Facebook Page can post; regular personal
# accounts can't). Create the app at developers.facebook.com, add the
# "Instagram Graph API" product, and set the OAuth redirect URI to
# http://localhost:4000/social-accounts/oauth/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Instagram browser login (personal accounts): scripts/instagram_browser_login.py
# --daemon runs on your desktop, opens Chrome for you to sign in and links the
# session. The web app reaches it through the API (/integrations/instagram/
# browser-login/*), so the API must be able to reach the helper. Default:
# http://localhost:4005 (API on the host or with host networking).
INSTAGRAM_HELPER_URL=

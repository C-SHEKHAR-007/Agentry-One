{
  "id": "social-publisher",
  "name": "Social Publisher (Action)",
  "version": "1.0",
  "description": "Publishes a generated caption and media to connected Social Media Accounts.",
  "entrypoint": {
    "queueName": "agent.social-publisher"
  },
  "steps": [
    {
      "key": "run",
      "description": "Publish to Social Media",
      "humanGate": false,
      "requiresSocialAccount": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "socialAccountId": {
            "type": "string",
            "title": "Connected Account"
          },
          "text": {
            "type": "string",
            "title": "Caption (overrides an input text artifact if both are present)"
          }
        },
        "required": ["socialAccountId"]
      },
      "consumesArtifactKinds": ["text", "image", "video"],
      "producesArtifactKinds": ["text"],
      "outputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  ]
}
